# 复制为 .env 后在本地填写；切勿提交真实密钥。
# 选择模型服务：deepseek（默认）或 anthropic
LLM_PROVIDER=
# 可选：覆盖默认模型名（deepseek 默认 deepseek-flash；anthropic 默认 claude-haiku-4-5）
LLM_MODEL=
# DeepSeek（经其 Anthropic 兼容端点调用）
DEEPSEEK_API_KEY=
# Anthropic 官方 API（需 Console 账户余额；Claude Pro 订阅不含 API 额度）
ANTHROPIC_API_KEY=
# 课程站本地端口（默认 5180，登记表 jdp-python.site）
# JDP_PYTHON_SITE_PORT=5180
# 代码解读 AI 讲解（本机 explain_server.py，默认 8031）
# JDP_PYTHON_EXPLAIN_PORT=8031
# JDP_PYTHON_EXPLAIN_HOST=127.0.0.1
# JDP_PYTHON_EXPLAIN_PROVIDER=ollama
# JDP_PYTHON_EXPLAIN_MODEL=qwen2.5-coder:7b
# JDP_PYTHON_EXPLAIN_OLLAMA_HOST=127.0.0.1:11434
# JDP_PYTHON_EXPLAIN_DAILY_LIMIT=200
# JDP_PYTHON_EXPLAIN_MAX_LINES=400
# JDP_PYTHON_EXPLAIN_TIMEOUT_SEC=60
