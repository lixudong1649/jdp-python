# 密钥与本地配置（任意层级）
.env
.env.*
!.env.example

# Python 虚拟环境、缓存与构建产物
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# 运行产物
/out/
/logs/
*.log

# 编辑器与系统文件
.DS_Store
.idea/
.vscode/

# 课程站点（site/）：依赖、构建产物与构建时复制的资源
site/node_modules/
site/.vitepress/dist/
site/.vitepress/dist-pages/
site/.vitepress/cache/
site/.vitepress/preview.pid
site/public/pyodide/
site/public/repo/
*.pid
